{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "B-T HOME: Build, Flash and Monitor (Zigbee + Wi-Fi AP)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "B-T HOME: build Zigbee + Wi-Fi AP",
        "B-T HOME: flash Zigbee + Wi-Fi AP",
        "B-T HOME: monitor Zigbee + Wi-Fi AP"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "B-T HOME: build Zigbee + Wi-Fi AP",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/idf.ps1",
        "-Action",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "B-T HOME: flash Zigbee + Wi-Fi AP",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/idf.ps1",
        "-Action",
        "flash",
        "-Port",
        "${config:idf.port}"
      ],
      "problemMatcher": []
    },
    {
      "label": "B-T HOME: monitor Zigbee + Wi-Fi AP",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/idf.ps1",
        "-Action",
        "monitor",
        "-Port",
        "${config:idf.port}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "B-T HOME: menuconfig Zigbee + Wi-Fi AP",
      "detail": "Налаштування Zigbee та Wi-Fi AP через ESP-IDF у Windows.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/idf.ps1",
        "-Action",
        "menuconfig"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "B-T HOME: host tests",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/test.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
