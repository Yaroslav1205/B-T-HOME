{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "B-T HOME: build ESP32-C6",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/idf.ps1", "-Action", "build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "B-T HOME: host tests",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": "$msCompile"
    }
  ]
}
