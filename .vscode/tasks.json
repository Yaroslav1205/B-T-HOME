{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "B-T HOME: Build, Flash and Monitor (Matter Wi-Fi)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "B-T HOME: build Matter Wi-Fi",
        "B-T HOME: flash Matter Wi-Fi",
        "B-T HOME: monitor Matter Wi-Fi"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "B-T HOME: build Matter Wi-Fi",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/matter.ps1",
        "-Action",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": "$gcc"
    },
    {
      "label": "B-T HOME: flash Matter Wi-Fi",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "${workspaceFolder}/scripts/matter.ps1", "-Action", "flash", "-Port", "${input:matterPort}"],
      "problemMatcher": []
    },
    {
      "label": "B-T HOME: monitor Matter Wi-Fi",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "${workspaceFolder}/scripts/matter.ps1", "-Action", "monitor", "-Port", "${input:matterPort}"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "B-T HOME: menuconfig Matter Wi-Fi",
      "detail": "Runs Matter menuconfig in WSL. Do not use the ESP-IDF extension's native confserver for the Windows bridge.",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
        "${workspaceFolder}/scripts/matter.ps1", "-Action", "menuconfig"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
    },
    {
      "label": "B-T HOME: menuconfig legacy Wi-Fi AP",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/idf.ps1",
        "-Action",
        "menuconfig",
        "-WifiAp"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "B-T HOME: host tests",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/test.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [{"id": "matterPort", "type": "promptString", "description": "USB serial port", "default": "COM11"}]
}
