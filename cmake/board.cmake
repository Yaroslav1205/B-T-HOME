if(NOT BTH_BOARD MATCHES "^[a-z][a-z0-9_]*$")
    message(FATAL_ERROR "Invalid BTH_BOARD: ${BTH_BOARD}")
endif()

set(BTH_BOARD_DIR "${CMAKE_CURRENT_LIST_DIR}/../boards/${BTH_BOARD}")
if(NOT EXISTS "${BTH_BOARD_DIR}/board.json")
    message(FATAL_ERROR "Unknown board '${BTH_BOARD}'. Add a profile under boards/ first.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${BTH_BOARD_DIR}/board.json")
file(READ "${BTH_BOARD_DIR}/board.json" BTH_BOARD_JSON)
string(JSON BTH_BOARD_TARGET GET "${BTH_BOARD_JSON}" target)
string(JSON BTH_BOARD_NAME GET "${BTH_BOARD_JSON}" name)
if(NOT BTH_BOARD_TARGET MATCHES "^esp32[a-z0-9]*$")
    message(FATAL_ERROR "Invalid target in board.json")
endif()

if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL BTH_BOARD_TARGET)
    message(FATAL_ERROR "IDF_TARGET conflicts with ${BTH_BOARD}. Use a separate build directory per board.")
endif()
if(DEFINED ENV{IDF_TARGET} AND NOT "$ENV{IDF_TARGET}" STREQUAL "" AND
   NOT "$ENV{IDF_TARGET}" STREQUAL BTH_BOARD_TARGET)
    message(FATAL_ERROR "Environment IDF_TARGET conflicts with ${BTH_BOARD}. Unset it before building.")
endif()
set(IDF_TARGET "${BTH_BOARD_TARGET}" CACHE STRING "ESP-IDF target")
message(STATUS "B-T HOME board: ${BTH_BOARD} (${BTH_BOARD_TARGET})")

# Generic profiles never claim a built-in LED pin.
set(BTH_RGB_LED_GPIO -1)
string(JSON BTH_RGB_LED_VALUE ERROR_VARIABLE BTH_RGB_LED_ERROR GET "${BTH_BOARD_JSON}" rgb_led_gpio)
if(NOT BTH_RGB_LED_ERROR)
    if(NOT BTH_RGB_LED_VALUE MATCHES "^[0-9]+$" OR BTH_RGB_LED_VALUE GREATER 48)
        message(FATAL_ERROR "Invalid rgb_led_gpio in board.json")
    endif()
    set(BTH_RGB_LED_GPIO "${BTH_RGB_LED_VALUE}")
endif()

set(BTH_RELAY_GPIO -1)
set(BTH_RELAY_ACTIVE_HIGH false)
string(JSON BTH_RELAY_VALUE ERROR_VARIABLE BTH_RELAY_ERROR GET "${BTH_BOARD_JSON}" relay_gpio)
if(NOT BTH_RELAY_ERROR)
    if(NOT BTH_RELAY_VALUE MATCHES "^[0-9]+$" OR BTH_RELAY_VALUE GREATER 48)
        message(FATAL_ERROR "Invalid relay_gpio in board.json")
    endif()
    if(BTH_RELAY_VALUE EQUAL BTH_RGB_LED_GPIO)
        message(FATAL_ERROR "Relay and RGB LED cannot share a GPIO")
    endif()
    string(JSON BTH_RELAY_POLARITY_TYPE TYPE "${BTH_BOARD_JSON}" relay_active_high)
    if(NOT BTH_RELAY_POLARITY_TYPE STREQUAL "BOOLEAN")
        message(FATAL_ERROR "relay_active_high must be an explicit boolean")
    endif()
    string(JSON BTH_RELAY_POLARITY GET "${BTH_BOARD_JSON}" relay_active_high)
    set(BTH_RELAY_GPIO "${BTH_RELAY_VALUE}")
    if(BTH_RELAY_POLARITY)
        set(BTH_RELAY_ACTIVE_HIGH true)
    endif()
endif()

# OLED wiring is opt-in per board; generic profiles do not acquire an I2C bus.
set(BTH_OLED_ENABLED false)
set(BTH_OLED_INTERNAL_PULLUPS false)
foreach(field IN ITEMS PORT SDA SCL SPEED_HZ ADDRESS CONTRAST)
    set(BTH_OLED_${field} 0)
endforeach()
string(JSON BTH_OLED_TYPE ERROR_VARIABLE BTH_OLED_ERROR TYPE "${BTH_BOARD_JSON}" oled)
if(NOT BTH_OLED_ERROR)
    string(JSON controller GET "${BTH_BOARD_JSON}" oled controller)
    string(JSON width GET "${BTH_BOARD_JSON}" oled width)
    string(JSON height GET "${BTH_BOARD_JSON}" oled height)
    string(JSON reset_gpio GET "${BTH_BOARD_JSON}" oled reset_gpio)
    if(NOT controller STREQUAL "ssd1306" OR NOT width EQUAL 128 OR
       NOT height EQUAL 32 OR NOT reset_gpio EQUAL -1)
        message(FATAL_ERROR "OLED adapter requires SSD1306 128x32 without a reset GPIO")
    endif()
    foreach(field IN ITEMS port sda scl speed_hz address contrast)
        string(JSON value GET "${BTH_BOARD_JSON}" oled ${field})
        if(NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "oled.${field} must be a nonnegative integer")
        endif()
        string(TOUPPER "${field}" upper_field)
        set(BTH_OLED_${upper_field} "${value}")
    endforeach()
    if(BTH_OLED_PORT GREATER 1 OR BTH_OLED_SDA GREATER 48 OR BTH_OLED_SCL GREATER 48 OR
       BTH_OLED_SDA EQUAL BTH_OLED_SCL OR BTH_OLED_ADDRESS LESS 8 OR
       BTH_OLED_ADDRESS GREATER 119 OR BTH_OLED_CONTRAST GREATER 255 OR
       BTH_OLED_SPEED_HZ LESS 10000 OR BTH_OLED_SPEED_HZ GREATER 400000)
        message(FATAL_ERROR "Invalid OLED bus, GPIO, address, contrast or frequency")
    endif()
    foreach(pin IN ITEMS BTH_OLED_SDA BTH_OLED_SCL)
        if(${pin} EQUAL BTH_RGB_LED_GPIO OR ${pin} EQUAL BTH_RELAY_GPIO)
            message(FATAL_ERROR "OLED cannot share a GPIO with relay or RGB LED")
        endif()
    endforeach()
    string(JSON pullup_type TYPE "${BTH_BOARD_JSON}" oled internal_pullups)
    if(NOT pullup_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "oled.internal_pullups must be a boolean")
    endif()
    string(JSON pullups GET "${BTH_BOARD_JSON}" oled internal_pullups)
    if(pullups)
        set(BTH_OLED_INTERNAL_PULLUPS true)
    endif()
    # Keep wiring recorded while the optional display is physically disconnected.
    string(JSON oled_enabled_type ERROR_VARIABLE oled_enabled_error TYPE "${BTH_BOARD_JSON}" oled enabled)
    if(oled_enabled_error)
        set(BTH_OLED_ENABLED true)
    else()
        if(NOT oled_enabled_type STREQUAL "BOOLEAN")
            message(FATAL_ERROR "oled.enabled must be a boolean")
        endif()
        string(JSON oled_enabled GET "${BTH_BOARD_JSON}" oled enabled)
        if(oled_enabled)
            set(BTH_OLED_ENABLED true)
        endif()
    endif()
endif()

# Mains ADC is assigned only by an explicit board profile.
set(BTH_MAINS_ADC_GPIO -1)
string(JSON mains_gpio ERROR_VARIABLE mains_error GET "${BTH_BOARD_JSON}" mains_adc_gpio)
if(NOT mains_error)
    if(NOT BTH_BOARD_TARGET STREQUAL "esp32c6" OR NOT mains_gpio MATCHES "^[0-6]$")
        message(FATAL_ERROR "mains_adc_gpio requires an ESP32-C6 ADC1 pin (0..6)")
    endif()
    if(mains_gpio EQUAL BTH_RGB_LED_GPIO OR mains_gpio EQUAL BTH_RELAY_GPIO)
        message(FATAL_ERROR "Mains ADC cannot share a GPIO with relay or RGB LED")
    endif()
    if(BTH_OLED_ENABLED AND (mains_gpio EQUAL BTH_OLED_SDA OR mains_gpio EQUAL BTH_OLED_SCL))
        message(FATAL_ERROR "Mains ADC cannot share an OLED GPIO")
    endif()
    set(BTH_MAINS_ADC_GPIO "${mains_gpio}")
endif()

# The DC channel shares the continuous ADC owner with mains.
set(BTH_DC_ADC_GPIO -1)
set(BTH_DC_DIVIDER_RATIO "1.0")
string(JSON dc_type ERROR_VARIABLE dc_error TYPE "${BTH_BOARD_JSON}" dc_input)
if(NOT dc_error)
    string(JSON dc_gpio GET "${BTH_BOARD_JSON}" dc_input gpio)
    string(JSON dc_upper GET "${BTH_BOARD_JSON}" dc_input upper_ohms)
    string(JSON dc_lower GET "${BTH_BOARD_JSON}" dc_input lower_ohms)
    if(NOT BTH_BOARD_TARGET STREQUAL "esp32c6" OR BTH_MAINS_ADC_GPIO LESS 0 OR
       NOT dc_gpio MATCHES "^[0-6]$")
        message(FATAL_ERROR "dc_input requires a mains ADC provider and an ESP32-C6 ADC1 pin (0..6)")
    endif()
    if(dc_gpio EQUAL BTH_MAINS_ADC_GPIO OR dc_gpio EQUAL BTH_RGB_LED_GPIO OR
       dc_gpio EQUAL BTH_RELAY_GPIO OR
       (BTH_OLED_ENABLED AND (dc_gpio EQUAL BTH_OLED_SDA OR dc_gpio EQUAL BTH_OLED_SCL)))
        message(FATAL_ERROR "DC ADC cannot share an assigned GPIO")
    endif()
    foreach(value IN ITEMS dc_upper dc_lower)
        if(NOT "${${value}}" MATCHES "^[1-9][0-9]*$" OR ${value} GREATER 1000000)
            message(FATAL_ERROR "DC divider resistances must be positive integers up to 1000000 ohms")
        endif()
    endforeach()
    math(EXPR dc_total "${dc_upper} + ${dc_lower}")
    math(EXPR dc_min_total "13 * ${dc_lower}")
    if(dc_total LESS dc_min_total)
        message(FATAL_ERROR "DC divider ratio must be at least 13 for the 30 V input")
    endif()
    set(BTH_DC_ADC_GPIO "${dc_gpio}")
    set(BTH_DC_DIVIDER_RATIO "(${dc_total}.0 / ${dc_lower}.0)")
endif()

set(BTH_BOOT_BUTTON_GPIO -1)
set(BTH_BOOT_BUTTON_ACTIVE_LOW true)
string(JSON boot_gpio ERROR_VARIABLE boot_error GET "${BTH_BOARD_JSON}" boot_button_gpio)
if(NOT boot_error)
    if(NOT boot_gpio MATCHES "^[0-9]+$" OR boot_gpio GREATER 48)
        message(FATAL_ERROR "Invalid boot_button_gpio")
    endif()
    if(boot_gpio EQUAL BTH_RGB_LED_GPIO OR boot_gpio EQUAL BTH_RELAY_GPIO OR
       boot_gpio EQUAL BTH_MAINS_ADC_GPIO OR boot_gpio EQUAL BTH_DC_ADC_GPIO OR
       (BTH_OLED_ENABLED AND (boot_gpio EQUAL BTH_OLED_SDA OR boot_gpio EQUAL BTH_OLED_SCL)))
        message(FATAL_ERROR "BOOT button cannot share an assigned GPIO")
    endif()
    string(JSON boot_polarity_type TYPE "${BTH_BOARD_JSON}" boot_button_active_low)
    if(NOT boot_polarity_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "boot_button_active_low must be an explicit boolean")
    endif()
    string(JSON boot_active_low GET "${BTH_BOARD_JSON}" boot_button_active_low)
    set(BTH_BOOT_BUTTON_GPIO "${boot_gpio}")
    if(NOT boot_active_low)
        set(BTH_BOOT_BUTTON_ACTIVE_LOW false)
    endif()
endif()

# Active buzzer wiring is explicitly enabled per board.
set(BTH_BUZZER_GPIO -1)
set(BTH_BUZZER_ACTIVE_HIGH false)
string(JSON buzzer_gpio ERROR_VARIABLE buzzer_error GET "${BTH_BOARD_JSON}" buzzer_gpio)
if(NOT buzzer_error)
    if(NOT buzzer_gpio MATCHES "^[0-9]+$" OR buzzer_gpio GREATER 48 OR BTH_MAINS_ADC_GPIO LESS 0)
        message(FATAL_ERROR "Buzzer requires an output GPIO and a mains ADC provider")
    endif()
    if(buzzer_gpio EQUAL BTH_RGB_LED_GPIO OR buzzer_gpio EQUAL BTH_RELAY_GPIO OR
       buzzer_gpio EQUAL BTH_BOOT_BUTTON_GPIO OR buzzer_gpio EQUAL BTH_MAINS_ADC_GPIO OR
       buzzer_gpio EQUAL BTH_DC_ADC_GPIO OR
       (BTH_OLED_ENABLED AND (buzzer_gpio EQUAL BTH_OLED_SDA OR buzzer_gpio EQUAL BTH_OLED_SCL)))
        message(FATAL_ERROR "Buzzer cannot share an assigned GPIO")
    endif()
    string(JSON buzzer_polarity_type TYPE "${BTH_BOARD_JSON}" buzzer_active_high)
    if(NOT buzzer_polarity_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "buzzer_active_high must be an explicit boolean")
    endif()
    string(JSON buzzer_active_high GET "${BTH_BOARD_JSON}" buzzer_active_high)
    set(BTH_BUZZER_GPIO "${buzzer_gpio}")
    if(buzzer_active_high)
        set(BTH_BUZZER_ACTIVE_HIGH true)
    endif()
endif()
