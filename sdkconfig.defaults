# Shared defaults. Persist deliberate changes here, not in generated sdkconfig.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=100
# Composition objects plus bounded ADC buffers and calibration call stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Allow browser request headers, including session cookies and User-Agent.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_BTH_HEARTBEAT_ENABLED=y
CONFIG_BTH_HEARTBEAT_INTERVAL_MS=5000
CONFIG_BTH_LOOP_INTERVAL_MS=20

# Verify HTTPS certificates for the official outage feed.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
