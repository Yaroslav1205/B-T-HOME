# Shared defaults. Persist deliberate changes here, not in generated sdkconfig.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_BTH_HEARTBEAT_ENABLED=y
CONFIG_BTH_HEARTBEAT_INTERVAL_MS=5000
CONFIG_BTH_LOOP_INTERVAL_MS=20
