CONFIG_BTH_MATTER_ENABLED=y
CONFIG_BTH_ZIGBEE_ENABLED=n
CONFIG_ZB_ENABLED=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_USE_MINIMAL_MDNS=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ENABLE_CHIP_SHELL=n
# Root node, metered plug, two electrical sensors and three compatibility temperature sensors.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=7
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_CHIP_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp32c6_rgb8/partitions.matter.csv"
CONFIG_ESP_MATTER_NVS_PART_NAME="matter_nvs"
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_CONFIG_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_COUNTERS_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_CHIP_KVS_NAMESPACE_PARTITION_LABEL="matter_nvs"
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8000
CONFIG_EXAMPLE_DAC_PROVIDER=y
CONFIG_EXAMPLE_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_CHIP_DISCOVERY_TIMEOUT_SECS=300
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Exclude unused clusters, following the ESP-Matter 1.4.2 example.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
